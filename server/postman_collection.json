                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"M001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "start"]
