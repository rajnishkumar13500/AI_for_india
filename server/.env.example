PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174

# AI APIs (Sarvam AI for Speech-to-Text & Conversational LLM)
# Enter your Sarvam subscription key below
SARVAM_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=sarvam
LLM_MODEL=sarvam-105b-conversations

# Optional MongoDB connection (default uses zero-setup local persistent store)
MONGODB_URI=

